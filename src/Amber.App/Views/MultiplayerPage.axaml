<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Amber.App.ViewModels"
             x:Class="Amber.App.Views.MultiplayerPage"
             x:DataType="vm:MultiplayerViewModel">
  <Grid RowDefinitions="Auto,*,Auto">
    <TextBlock Classes="h1" Text="联机" />

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="14" Margin="0,0,14,14">

        <!-- 组件 -->
        <Border Classes="card" Margin="0">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding ComponentText}" TextWrapping="Wrap" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" IsVisible="{Binding !IsComponentReady}">
                <Button Classes="amber" Content="下载联机组件" Command="{Binding DownloadComponentCommand}" IsVisible="{Binding !IsDownloading}" />
                <Button Content="取消" Command="{Binding CancelDownloadCommand}" IsVisible="{Binding IsDownloading}" />
              </StackPanel>
            </Grid>
            <ProgressBar Value="{Binding DownloadPercent}" Maximum="100" IsVisible="{Binding IsDownloading}" />
            <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{Binding LicenseText}" />
          </StackPanel>
        </Border>

        <!-- 还没开始：开房间 / 加入房间 -->
        <Grid ColumnDefinitions="*,14,*" IsVisible="{Binding IsIdle}">
          <Border Classes="card" Margin="0">
            <StackPanel Spacing="8">
              <TextBlock Classes="h2" Text="我来开房间" Margin="0" />
              <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap"
                         Text="先进入世界，在暂停菜单点“对局域网开放”。用 Amber 启动的游戏会自动出现在这里，其他启动器开的游戏点“查找”。" />
              <Grid ColumnDefinitions="*,Auto">
                <ComboBox ItemsSource="{Binding LanGames}" SelectedItem="{Binding SelectedLanGame}" HorizontalAlignment="Stretch" PlaceholderText="还没找到开放的游戏">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="vm:LanGameItem"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Content="查找" Command="{Binding ScanCommand}" Margin="6,0,0,0" ToolTip.Tip="听本机的局域网广播，找其他启动器打开的游戏。Windows 可能询问防火墙权限，选哪个都不影响本机查找。" />
              </Grid>
              <TextBox Text="{Binding ManualPort}" PlaceholderText="或者手动填端口（游戏聊天栏里显示的那个）" />
              <Button Classes="amber" Content="创建房间" Command="{Binding CreateRoomCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="card" Margin="0">
            <StackPanel Spacing="8">
              <TextBlock Classes="h2" Text="加入朋友的房间" Margin="0" />
              <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="把朋友发来的房间码粘贴到这里。" />
              <TextBox Text="{Binding JoinCode}" PlaceholderText="AMB-XXXXXXXX-XXXXXXXXXXXX-端口" />
              <Button Classes="amber" Content="加入房间" Command="{Binding JoinCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- 直连房间：不用联机节点 -->
        <Border Classes="card" Margin="0" IsVisible="{Binding IsIdle}">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="直连（不用联机节点）" Margin="0" />
            <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap"
                       Text="双方互发一次码，Amber 依次尝试 IPv6 直连、路由器映射端口、IPv4 打洞，能直连就不经过任何服务器。都不通时，如果下面添加了联机节点，会改用节点。先点“检测我的网络”看看好不好连。" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="检测我的网络" Command="{Binding CheckNetworkCommand}" IsEnabled="{Binding !IsCheckingNetwork}" />
              <CheckBox Content="打不通时用联机节点" IsChecked="{Binding DirectUseNodes}" />
              <CheckBox Content="调试模式" IsChecked="{Binding DebugMode}" ToolTip.Tip="显示详细日志（包括 EasyTier 自己的日志），可以导出诊断报告" />
            </StackPanel>
            <SelectableTextBlock Text="{Binding NetworkCheckText}" TextWrapping="Wrap" FontSize="12" IsVisible="{Binding NetworkCheckText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Grid ColumnDefinitions="*,14,*">
              <StackPanel Spacing="6">
                <TextBlock Text="我来开房间（用上面选好的游戏端口）" FontWeight="SemiBold" />
                <Button Classes="amber" Content="创建直连房间" Command="{Binding CreateDirectRoomCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Text="加入朋友的直连房间" FontWeight="SemiBold" />
                <TextBox Text="{Binding DirectInviteInput}" PlaceholderText="粘贴邀请码（AMBDIRECT1-…）" />
                <Button Classes="amber" Content="加入" Command="{Binding JoinDirectCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              </StackPanel>
            </Grid>
            <Expander Header="STUN 服务器（只用来查你的外部地址，不经过游戏数据）">
              <TextBox Text="{Binding StunText}" PlaceholderText="host:port，用逗号分隔；清空就不查" />
            </Expander>
          </StackPanel>
        </Border>

        <Border Classes="card" Margin="0" IsVisible="{Binding IsIdle}">
          <StackPanel Spacing="4">
            <CheckBox Content="完整局域网模式（需要管理员权限）" IsChecked="{Binding FullLanMode}" />
            <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap"
                       Text="一般不用开。默认模式只转发游戏端口，不需要管理员权限。开启后会建一块名为“Amber LAN”的虚拟网卡，每个人有一个虚拟 IP，局域网里的其他游戏和程序也能互通，游戏发的局域网广播也会转发给房间里的人；创建或加入房间时 Windows 会弹出权限确认，结束联机或关闭 Amber 时虚拟网卡随之关闭。双方都要开启这个模式。" />
            <CheckBox Content="允许成员通过我的电脑上网（出口节点）" IsChecked="{Binding AllowExitNode}" IsEnabled="{Binding FullLanMode}" Margin="0,6,0,0" />
            <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding AllowExitNode}" Foreground="#E0703A"
                       Text="注意：开启后，房间里选了你做出口的人，他们的全部网络流量会从你的电脑和网络出去，在外人看来就是你的 IP 在访问，你要为这些流量负责；也会占用你的带宽。只对信任的人开启。" />
          </StackPanel>
        </Border>

        <!-- 正在经别人上网 -->
        <Border Classes="card" Margin="0" IsVisible="{Binding UsingExit}" BorderBrush="#E0703A" BorderThickness="2">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding ExitBanner}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Button Grid.Column="1" Classes="amber" Content="停止，恢复正常上网" Command="{Binding StopExitNodeCommand}" Margin="12,0,0,0" />
          </Grid>
        </Border>

        <!-- 房主 -->
        <Border Classes="card" Margin="0" IsVisible="{Binding IsHosting}">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="房间已开" Margin="0" />
            <TextBlock Text="房间码（发给朋友）" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding RoomCodeText}" IsReadOnly="True" FontFamily="Consolas,monospace" FontSize="16" />
              <Button Grid.Column="1" Content="复制" Command="{Binding CopyRoomCodeCommand}" Margin="6,0,0,0" />
            </Grid>
            <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="房间码里含密钥，只发给要一起玩的人。游戏要一直开着，世界也要保持“对局域网开放”。" />
            <TextBlock Text="{Binding MyVirtualIp, StringFormat='本机虚拟 IP：{0}'}" IsVisible="{Binding MyVirtualIp, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>

        <!-- 加入方 -->
        <Border Classes="card" Margin="0" IsVisible="{Binding IsJoined}">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="已加入房间" Margin="0" />
            <TextBlock Text="在游戏里连接这个地址" />
            <TextBox Text="{Binding JoinAddress}" IsReadOnly="True" FontFamily="Consolas,monospace" FontSize="16" />
            <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="游戏的“多人游戏”页面下方的局域网列表里也会出现“Amber 联机房间”（完整局域网模式下请直接添加上面的地址）。" />
            <TextBlock Text="{Binding MyVirtualIp, StringFormat='本机虚拟 IP：{0}'}" IsVisible="{Binding MyVirtualIp, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="用这个版本" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding Instances}" SelectedItem="{Binding TargetInstance}" MinWidth="220" />
              <Button Content="加到服务器列表" Command="{Binding AddToServersCommand}" />
              <Button Classes="amber" Content="启动并进入" Command="{Binding LaunchAndJoinCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 直连房间：码、路径、全条件测试 -->
        <Border Classes="card" Margin="0" IsVisible="{Binding IsDirect}">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="直连" Margin="0" />
            <TextBlock Text="{Binding PathText, StringFormat='当前路径：{0}'}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{Binding DirectHint}" />
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding MyDirectCode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBox Text="{Binding MyDirectCode}" IsReadOnly="True" FontFamily="Consolas,monospace" FontSize="11" TextWrapping="Wrap" MaxHeight="70" />
              <Button Grid.Column="1" Content="复制" Command="{Binding CopyDirectCodeCommand}" Margin="6,0,0,0" VerticalAlignment="Top" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsDirectHost}">
              <TextBox Text="{Binding DirectReplyInput}" PlaceholderText="粘贴朋友发回的回复码（AMBREPLY1-…）" />
              <Button Grid.Column="1" Content="连接" Command="{Binding AddDirectReplyCommand}" Margin="6,0,0,0" />
            </Grid>
            <StackPanel Spacing="6" IsVisible="{Binding IsDirectHost}">
              <TextBlock Text="全条件测试" FontWeight="SemiBold" Margin="0,6,0,0" />
              <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap"
                         Text="朋友加入后，一键按顺序测每种组合（IPv6、映射端口、打洞、喷洒、中转、节点；默认模式和完整局域网；出口开关），记下是否连通、用时、延迟、吞吐和失败原因。双方自动同步切换，每步有超时。" />
              <CheckBox Content="包含完整局域网和出口（开始时双方各确认一次管理员权限，拒绝就跳过）" IsChecked="{Binding MatrixFullLan}" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="amber" Content="开始全条件测试" Command="{Binding RunMatrixCommand}" IsEnabled="{Binding !MatrixRunning}" />
                <Button Content="停止" Command="{Binding CancelMatrixCommand}" IsVisible="{Binding MatrixRunning}" />
              </StackPanel>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding MatrixLines}" IsVisible="{Binding !!MatrixLines.Count}">
              <ItemsControl.ItemTemplate>
                <DataTemplate><SelectableTextBlock Text="{Binding}" FontFamily="Consolas,monospace" FontSize="11" TextWrapping="Wrap" /></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- 调试日志 -->
        <Border Classes="card" Margin="0" IsVisible="{Binding DebugMode}">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBlock Classes="h2" Text="调试日志" Margin="0" VerticalAlignment="Center" />
              <CheckBox Grid.Column="1" Content="报告里包含完整公网 IP" IsChecked="{Binding IncludePublicIps}" Margin="0,0,8,0" />
              <Button Grid.Column="2" Content="导出诊断报告…" Click="ExportDiagnostics_Click" />
            </Grid>
            <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="日志只在内存里。导出的报告会去掉房间密钥和各种码，默认遮住公网 IP 的后半段，可以放心发给帮你排查的人。" />
            <Border Background="{DynamicResource PageBackground}" CornerRadius="6" Padding="8" Height="260">
              <ScrollViewer Name="DebugScroll">
                <ItemsControl ItemsSource="{Binding DebugLines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate><SelectableTextBlock Text="{Binding}" FontFamily="Consolas,monospace" FontSize="11" TextWrapping="Wrap" /></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </StackPanel>
        </Border>

        <!-- 聊天 -->
        <Border Classes="card" Margin="0" IsVisible="{Binding !IsIdle}">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="h2" Text="房间聊天" Margin="0" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="导出聊天记录…" Click="ExportChat_Click" />
            </Grid>
            <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{Binding ChatStatus}" />
            <Border Background="{DynamicResource PageBackground}" CornerRadius="6" Padding="8" Height="220">
              <ScrollViewer Name="ChatScroll">
                <ItemsControl ItemsSource="{Binding ChatLines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ChatLine">
                      <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                        <TextBlock Text="{Binding Time}" Classes="hint" FontSize="11" Margin="0,2,8,0" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" IsVisible="{Binding !IsNotice}" />
                          <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" Classes.hint="{Binding IsNotice}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding ChatInput}" PlaceholderText="说点什么（最多 500 字，回车发送）" MaxLength="500" KeyDown="ChatInput_KeyDown" IsEnabled="{Binding ChatReady}" />
              <Button Grid.Column="1" Classes="amber" Content="发送" Command="{Binding SendChatCommand}" IsEnabled="{Binding ChatReady}" Margin="6,0,0,0" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- 房间成员 -->
        <Border Classes="card" Margin="0" IsVisible="{Binding !IsIdle}">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="h2" Text="房间里的人" Margin="0" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="结束联机" Command="{Binding StopCommand}" />
            </Grid>
            <TextBlock Classes="hint" Text="还没有人" IsVisible="{Binding !Peers.Count}" />
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding CanUseExit}">
              <TextBlock Text="经这个人的电脑上网" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding ExitCandidates}" SelectedItem="{Binding SelectedExitPeer}" MinWidth="200">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="vm:PeerItem"><TextBlock Text="{Binding Meta}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="开始" Command="{Binding UseExitNodeCommand}" IsEnabled="{Binding !UsingExit}" ToolTip.Tip="对方要先开启“允许成员通过我的电脑上网”。会重新弹出 Windows 权限确认。" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Peers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:PeerItem">
                  <StackPanel Margin="0,3">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Meta}" Classes="hint" FontSize="11" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- 联机节点 -->
        <Border Classes="card" Margin="0">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="联机节点" FontWeight="SemiBold" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="测试延迟" Command="{Binding TestNodesCommand}" />
              </StackPanel>
            </Grid>
            <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap"
                       Text="双方先连到同一个节点互相找到对方，能直连就直连，连不上时由节点转发。Amber 没有自己的服务器，也不内置节点：用自己搭的节点（项目 node 文件夹里有一键部署脚本），或者导入朋友发来的节点分享码。" />
            <TextBlock Classes="hint" Text="还没有节点" IsVisible="{Binding !Nodes.Count}" />
            <ItemsControl ItemsSource="{Binding Nodes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:NodeItem">
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                    <TextBlock Text="{Binding Url}" FontFamily="Consolas,monospace" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding LatencyText}" Classes="hint" VerticalAlignment="Center" Margin="10,0" />
                    <Button Grid.Column="2" Content="删除" Command="{Binding $parent[ItemsControl].((vm:MultiplayerViewModel)DataContext).RemoveNodeCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding NewNodeUrl}" PlaceholderText="tcp://节点地址:11010" FontFamily="Consolas,monospace" />
              <Button Grid.Column="1" Content="添加" Command="{Binding AddNodeCommand}" Margin="6,0,0,0" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBox Text="{Binding ShareCodeText}" PlaceholderText="节点分享码（AMBNODE-…）" />
              <Button Grid.Column="1" Content="导入" Command="{Binding ImportNodesCommand}" Margin="6,0,0,0" />
              <Button Grid.Column="2" Content="导出并复制" Command="{Binding ExportNodesCommand}" Margin="6,0,0,0" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Classes="card" Margin="0" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
