<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Amber.App.Localization"
             xmlns:vm="using:Amber.App.ViewModels"
             x:Class="Amber.App.Views.InstancePage"
             x:DataType="vm:InstanceViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <TextBlock Classes="h1" Text="{l:T instance.title}" />

    <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,8">
      <Grid ColumnDefinitions="*,Auto">
        <ComboBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedId}" HorizontalAlignment="Stretch" PlaceholderText="{l:T instance.version.empty}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
          <Button Content="{l:T common.open_folder}" Command="{Binding OpenFolderCommand}" />
          <Button Content="{l:T instance.files.complete}" Command="{Binding CompleteFilesCommand}" />
          <Button Content="{l:T instance.export.script}" Click="ExportScript_Click" />
          <Button Content="{Binding DeleteArmed, Converter={x:Static vm:Converters.DeleteLabel}}" Command="{Binding DeleteVersionCommand}" />
        </StackPanel>
      </Grid>
      <TextBlock Classes="hint" FontSize="12" Text="{Binding InfoText}" TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <Border Grid.Row="2" Classes="card" Padding="10" IsVisible="{Binding HasInstance}">
      <TabControl SelectedIndex="{Binding TabIndex}" Padding="0,8,0,0">
        <TabItem Header="{l:T instance.settings.title}" FontSize="14">
          <ScrollViewer>
            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,0,14,0">
              <Grid.Styles>
                <Style Selector="TextBlock.label"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="0,8,0,0" /></Style>
              </Grid.Styles>
              <TextBlock Classes="label" Text="{l:T instance.settings.isolation}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding TriState}" SelectedIndex="{Binding IsolateIndex}" MinWidth="200" Margin="0,8,0,0" />

              <TextBlock Grid.Row="1" Classes="label" Text="Java" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding JavaChoices}" SelectedItem="{Binding SelectedJava}" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="vm:JavaChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Grid.Row="2" Classes="label" Text="{l:T instance.settings.memory}" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <ComboBox ItemsSource="{Binding MemoryModes}" SelectedIndex="{Binding MemoryModeIndex}" MinWidth="160" />
                <TextBox Text="{Binding MemoryText}" Width="100" PlaceholderText="MB" />
                <TextBlock Classes="hint" Text="{l:T instance.settings.manual_hint}" VerticalAlignment="Center" />
              </StackPanel>

              <TextBlock Grid.Row="3" Classes="label" Text="{l:T instance.settings.jvm_args}" />
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding JvmArgs}" Margin="0,8,0,0" PlaceholderText="{l:T instance.settings.jvm_hint}" />

              <TextBlock Grid.Row="4" Classes="label" Text="{l:T instance.settings.game_args}" />
              <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding GameArgs}" Margin="0,8,0,0" PlaceholderText="{l:T instance.settings.inherit_hint}" />

              <TextBlock Grid.Row="5" Classes="label" Text="{l:T instance.settings.window_size}" />
              <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <TextBox Text="{Binding WidthText}" Width="90" PlaceholderText="{l:T instance.settings.width}" />
                <TextBlock Text="×" VerticalAlignment="Center" />
                <TextBox Text="{Binding HeightText}" Width="90" PlaceholderText="{l:T instance.settings.height}" />
              </StackPanel>

              <TextBlock Grid.Row="6" Classes="label" Text="{l:T instance.settings.fullscreen}" />
              <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding TriState}" SelectedIndex="{Binding FullscreenIndex}" MinWidth="200" Margin="0,8,0,0" />

              <TextBlock Grid.Row="7" Classes="label" Text="{l:T instance.settings.pre_launch}" />
              <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding PreLaunch}" Margin="0,8,0,0" PlaceholderText="{l:T instance.settings.pre_launch_hint}" />

              <TextBlock Grid.Row="8" Classes="label" Text="{l:T instance.settings.post_exit}" />
              <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding PostExit}" Margin="0,8,0,0" />

              <TextBlock Grid.Row="9" Classes="label" Text="{l:T instance.settings.join_server}" />
              <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding JoinServer}" Margin="0,8,0,0" PlaceholderText="{l:T instance.settings.join_server_hint}" />

              <Button Grid.Row="10" Grid.Column="1" Classes="amber" Content="{l:T instance.settings.save}" Command="{Binding SaveSettingsCommand}" Margin="0,12,0,4" />
            </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{l:T instance.mods.title}" FontSize="14">
          <Grid RowDefinitions="Auto,Auto,*">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
              <TextBlock Classes="hint" Text="{Binding ModSummary}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="{l:T common.add_files}" Click="AddMods_Click" />
                <Button Content="{l:T common.open_folder}" Command="{Binding OpenModsFolderCommand}" />
                <Button Content="{l:T common.check_updates}" Command="{Binding CheckModUpdatesCommand}" />
                <Button Content="{l:T common.update_all}" Command="{Binding UpdateAllModsCommand}" />
              </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,6" IsVisible="{Binding CompatSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding CompatSummary}" FontSize="12" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding NeedsConnector}">
                <TextBlock Classes="hint" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="{l:T instance.connector.hint}" />
                <Button Content="{l:T instance.connector.install}" Command="{Binding InstallConnectorCommand}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasConnectorPending}">
                <TextBlock Classes="hint" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560" Text="{Binding ConnectorPendingText}" />
                <Button Content="{l:T instance.connector.prewarm}" Command="{Binding PrewarmConnectorCommand}"
                        ToolTip.Tip="{l:T instance.connector.prewarm_hint}" />
              </StackPanel>
            </StackPanel>
            <TextBlock Grid.Row="2" Classes="hint" Text="{l:T instance.mods.empty}" IsVisible="{Binding !Mods.Count}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ListBox Grid.Row="2" ItemsSource="{Binding Mods}" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:ModItem">
                  <Grid ColumnDefinitions="Auto,40,*,Auto" Margin="2">
                    <CheckBox IsChecked="{Binding Enabled}" MinWidth="0" Margin="0,0,6,0" ToolTip.Tip="{l:T common.toggle_enabled}" />
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="5" Background="{DynamicResource PageBackground}" ClipToBounds="True">
                      <Image Source="{Binding Icon}" />
                    </Border>
                    <StackPanel Grid.Column="2" Margin="10,0">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Meta}" Classes="hint" FontSize="11" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding UpdateText}" IsVisible="{Binding HasUpdate}" FontSize="11" Foreground="{DynamicResource AmberAccent}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding CompatText}" IsVisible="{Binding CompatText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" FontSize="11" TextWrapping="Wrap"
                                 Foreground="{Binding HasCompatProblem, Converter={x:Static vm:Converters.ProblemBrush}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Button Content="{l:T common.update}" IsVisible="{Binding HasUpdate}" Command="{Binding $parent[ListBox].((vm:InstanceViewModel)DataContext).UpdateModCommand}" CommandParameter="{Binding}" />
                      <Button Content="{l:T instance.mods.find_matching}" IsVisible="{Binding CanFindMatching}" Command="{Binding $parent[ListBox].((vm:InstanceViewModel)DataContext).FindMatchingCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="{l:T instance.mods.find_matching_hint}" />
                      <Button Content="{l:T common.delete}" Command="{Binding $parent[ListBox].((vm:InstanceViewModel)DataContext).DeleteModCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </TabItem>

        <TabItem Header="{l:T instance.worlds.title}" FontSize="14">
          <Grid RowDefinitions="Auto,*,Auto">
            <Button Content="{l:T instance.worlds.import}" Click="ImportWorld_Click" Margin="0,0,0,6" />
            <TextBlock Grid.Row="1" Classes="hint" Text="{l:T instance.worlds.empty}" IsVisible="{Binding !Worlds.Count}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ListBox Grid.Row="1" ItemsSource="{Binding Worlds}" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:WorldItem">
                  <Grid ColumnDefinitions="*,Auto" Margin="2">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Meta}" Classes="hint" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Button Content="{l:T common.enter}" IsVisible="{Binding $parent[ListBox].((vm:InstanceViewModel)DataContext).SupportsQuickPlay}"
                              Command="{Binding $parent[ListBox].((vm:InstanceViewModel)DataContext).JoinWorldCommand}" CommandParameter="{Binding}" />
                      <Button Content="{l:T instance.datapacks.title}" Command="{Binding $parent[ListBox].((vm:InstanceViewModel)DataContext).ShowDatapacksCommand}" CommandParameter="{Binding}" />
                      <Button Content="{l:T common.backup}" Command="{Binding $parent[ListBox].((vm:InstanceViewModel)DataContext).BackupWorldCommand}" CommandParameter="{Binding}" />
                      <Button Content="{l:T common.open}" Command="{Binding $parent[ListBox].((vm:InstanceViewModel)DataContext).OpenWorldCommand}" CommandParameter="{Binding}" />
                      <Button Content="{l:T common.delete}" Command="{Binding $parent[ListBox].((vm:InstanceViewModel)DataContext).DeleteWorldCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Row="2" IsVisible="{Binding HasDatapackWorld}" BorderBrush="{DynamicResource PageBackground}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,6,0,0">
              <Grid RowDefinitions="Auto,Auto,Auto" MaxHeight="260">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding DatapackTitle}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Content="{l:T instance.datapacks.download}" Command="{Binding BrowseDatapacksCommand}" />
                    <Button Content="{l:T common.add_files}" Click="AddDatapacks_Click" />
                    <Button Content="{l:T common.open_folder}" Command="{Binding OpenDatapacksFolderCommand}" />
                    <Button Content="{l:T common.collapse}" Command="{Binding CloseDatapacksCommand}" />
                  </StackPanel>
                </Grid>
                <TextBlock Grid.Row="1" Classes="hint" FontSize="12" Margin="0,4" TextWrapping="Wrap"
                           Text="{l:T instance.datapacks.hint}" />
                <ScrollViewer Grid.Row="2">
                  <ItemsControl ItemsSource="{Binding Datapacks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:DatapackItem">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,3">
                          <CheckBox IsChecked="{Binding Enabled}" MinWidth="0" Margin="0,0,6,0" ToolTip.Tip="{l:T common.toggle_enabled}" />
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Meta}" Classes="hint" FontSize="11" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Button Grid.Column="2" Content="{l:T common.delete}" VerticalAlignment="Center"
                                  Command="{Binding $parent[ItemsControl].((vm:InstanceViewModel)DataContext).DeleteDatapackCommand}" CommandParameter="{Binding}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>
        </TabItem>

        <TabItem Header="{l:T instance.screenshots.title}" FontSize="14">
          <Grid RowDefinitions="Auto,*">
            <Button Content="{l:T common.open_folder}" Command="{Binding OpenScreenshotsFolderCommand}" Margin="0,0,0,6" />
            <ScrollViewer Grid.Row="1">
              <ItemsControl ItemsSource="{Binding Screenshots}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:ScreenshotItem">
                    <StackPanel Width="180" Margin="0,0,10,10">
                      <Button Padding="0" Background="Transparent" Command="{Binding $parent[ItemsControl].((vm:InstanceViewModel)DataContext).OpenScreenshotCommand}" CommandParameter="{Binding}">
                        <Image Source="{Binding Thumbnail}" Height="102" Stretch="UniformToFill" />
                      </Button>
                      <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                        <TextBlock Text="{Binding Name}" Classes="hint" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="{l:T common.delete}" Padding="6,1" FontSize="11" Command="{Binding $parent[ItemsControl].((vm:InstanceViewModel)DataContext).DeleteScreenshotCommand}" CommandParameter="{Binding}" />
                      </Grid>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </TabItem>

        <TabItem Header="{l:T instance.resourcepacks.title}" FontSize="14">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
              <Button Content="{l:T common.add_files}" Click="AddResourcePacks_Click" />
              <Button Content="{l:T common.open_folder}" Command="{Binding OpenResourcePacksFolderCommand}" />
            </StackPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding ResourcePacks}" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:PackFileItem">
                  <Grid ColumnDefinitions="*,80,Auto">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Size}" Classes="hint" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="{l:T common.delete}" Command="{Binding $parent[ListBox].((vm:InstanceViewModel)DataContext).DeletePackCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </TabItem>

        <TabItem Header="{l:T instance.shaderpacks.title}" FontSize="14">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
              <Button Content="{l:T common.add_files}" Click="AddShaderPacks_Click" />
              <Button Content="{l:T common.open_folder}" Command="{Binding OpenShaderPacksFolderCommand}" />
            </StackPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding ShaderPacks}" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:PackFileItem">
                  <Grid ColumnDefinitions="*,80,Auto">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Size}" Classes="hint" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="{l:T common.delete}" Command="{Binding $parent[ListBox].((vm:InstanceViewModel)DataContext).DeletePackCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </TabItem>

        <TabItem Header="{l:T instance.servers.title}" FontSize="14">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="160,*,Auto,Auto" Margin="0,0,0,6">
              <TextBox Text="{Binding NewServerName}" PlaceholderText="{l:T common.name}" />
              <TextBox Grid.Column="1" Text="{Binding NewServerAddress}" PlaceholderText="{l:T instance.servers.address_hint}" Margin="6,0" />
              <Button Grid.Column="2" Content="{l:T common.add}" Command="{Binding AddServerCommand}" />
              <Button Grid.Column="3" Content="{l:T common.refresh}" Command="{Binding RefreshServersCommand}" Margin="6,0,0,0" />
            </Grid>
            <TextBlock Grid.Row="1" Classes="hint" Text="{l:T instance.servers.empty}" IsVisible="{Binding !Servers.Count}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ListBox Grid.Row="1" ItemsSource="{Binding Servers}" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:ServerItem">
                  <Grid ColumnDefinitions="*,Auto" Margin="2">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="hint" FontSize="11" Text="{Binding Address}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="hint" FontSize="11" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Button Content="{l:T common.enter}" Command="{Binding $parent[ListBox].((vm:InstanceViewModel)DataContext).JoinServerNowCommand}" CommandParameter="{Binding}" />
                      <Button Content="{l:T common.remove}" Command="{Binding $parent[ListBox].((vm:InstanceViewModel)DataContext).RemoveServerCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </TabItem>

        <TabItem Header="{l:T instance.export.title}" FontSize="14">
          <ScrollViewer>
            <StackPanel Spacing="8" Margin="0,0,14,0">
              <TextBlock Text="{l:T instance.export.pack_heading}" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding ExportFormats}" SelectedIndex="{Binding ExportFormatIndex}" MinWidth="220" />
              <TextBox Text="{Binding ExportName}" PlaceholderText="{l:T instance.export.name_hint}" />
              <TextBox Text="{Binding ExportVersion}" PlaceholderText="{l:T instance.export.version_hint}" />
              <TextBlock Text="{l:T instance.export.include}" FontWeight="SemiBold" Margin="0,6,0,0" />
              <ItemsControl ItemsSource="{Binding ExportOptions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:ExportOption">
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Include}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="hint" Text="{l:T instance.export.hint}" />
              <Button Classes="amber" Content="{l:T instance.export.save}" Click="ExportPack_Click" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Border>

    <Border Grid.Row="3" Classes="card" Margin="0" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" MinHeight="18" />
          <ProgressBar Value="{Binding Progress}" Maximum="100" IsVisible="{Binding IsBusy}" />
        </StackPanel>
        <Button Grid.Column="1" Content="{l:T common.cancel}" Command="{Binding CancelWorkCommand}" IsVisible="{Binding IsBusy}" Margin="12,0,0,0" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
