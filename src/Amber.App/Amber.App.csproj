<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Amber</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\amber.ico</ApplicationIcon>
    <TieredPGO>false</TieredPGO>
    <!--
      关掉 Avalonia 的编译统计（Avalonia.BuildServices）：它每次编译都会另起一个 dotnet 进程把统计发出去，
      项目规则不允许遥测；在没有写权限的环境（沙箱、CI）里那个进程还会因为未处理的异常弹出“应用程序错误”对话框。
      Avalonia 的包把这个属性设成 ;AvaloniaUI，统计目标只在它非空时运行；这里在包的 props 之后把它清空。
    -->
    <UsedAvaloniaProducts></UsedAvaloniaProducts>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\amber.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Amber.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Amber.Core\Amber.Core.csproj" />
  </ItemGroup>

</Project>
